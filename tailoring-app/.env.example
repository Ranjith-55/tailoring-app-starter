# Copy this file to .env.local and fill in your own Supabase project values.
# Find these in your Supabase project: Settings -> API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only used by the optional Edge Function (supabase/functions/create-staff).
# NEVER put the service role key in NEXT_PUBLIC_ variables or frontend code.
# It's set as a Supabase secret, not read from this file, but listed here for reference.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key (server-side only)
